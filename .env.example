# Copie para .env (que fica fora do Git) e ajuste conforme o ambiente.
# Nenhum destes valores deve ser commitado com conteúdo real.

# Obrigatória quando STARMAP_AMBIENTE=producao. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Caminho do banco SQLite. Mantenha fora de pastas servidas estaticamente.
DATABASE_PATH=data/starmap.db

# desenvolvimento | producao
STARMAP_AMBIENTE=desenvolvimento

# Debugger do Werkzeug. NUNCA ligue em servidor exposto: ele permite execução
# de código arbitrário pelo navegador.
FLASK_DEBUG=0

# Trava de escrita: 1 bloqueia POST/PATCH/DELETE na API (mapa só de leitura).
# Use enquanto não houver autenticação e o mapa estiver publicado.
STARMAP_SOMENTE_LEITURA=0

# Porta do servidor de desenvolvimento.
PORT=5173
